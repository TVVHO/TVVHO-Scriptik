local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({Name = "TVVHO Hub", HidePremium = false, SaveConfig = true, ConfigFolder = "TVVHOCfg"})

-- Вкладка Игрок
local Tab1 = Window:MakeTab({
 Name = "Персонаж",
 Icon = "rbxassetid://4483345998",
 PremiumOnly = false
})

Tab1:AddSlider({
 Name = "Скорость бега",
 Min = 16,
 Max = 500,
 Default = 16,
 Color = Color3.fromRGB(255,255,255),
 Increment = 1,
 ValueName = "Speed",
 Callback = function(Value)
  game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
 end    
})

Tab1:AddSlider({
 Name = "Сила прыжка",
 Min = 50,
 Max = 500,
 Default = 50,
 Color = Color3.fromRGB(255,255,255),
 Increment = 1,
 ValueName = "Jump",
 Callback = function(Value)
  game.Players.LocalPlayer.Character.Humanoid.JumpPower = Value
 end    
})

Tab1:AddButton({
 Name = "Сбросить всё на стандарт",
 Callback = function()
  game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16
  game.Players.LocalPlayer.Character.Humanoid.JumpPower = 50
 end    
})

-- Вкладка Инфо
local Tab2 = Window:MakeTab({
 Name = "Инфо",
 Icon = "rbxassetid://4483345998",
 PremiumOnly = false
})

Tab2:AddLabel("Создатель скрипта: TVVHO")
Tab2:AddLabel("Статус: Активен")

OrionLib:Init()
